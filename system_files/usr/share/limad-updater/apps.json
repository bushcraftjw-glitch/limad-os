{
  "format_version": 2,
  "apps": [
    {
      "app_id": "de.limad.Cut",
      "name": "LiMaD Cut",
      "launcher": "/usr/local/bin/limad-cut",
      "system_root": "/usr/share/limad-cut",
      "system_version_file": "/usr/share/limad-cut/VERSION",
      "required": [
        "native_shell.py",
        "VERSION"
      ],
      "restart_user_services": []
    },
    {
      "app_id": "de.limad.Study",
      "name": "LiMaD Study",
      "launcher": "/usr/local/bin/limad-study",
      "system_root": "/usr/share/limad-study",
      "system_version_file": "/usr/share/limad-study/VERSION",
      "required": [
        "src/limad_study/__main__.py",
        "web/index.html",
        "VERSION"
      ],
      "post_install": "study-prepare",
      "restart_user_services": []
    },
    {
      "app_id": "de.limad.Drop",
      "name": "LiDrop",
      "launcher": "/usr/local/bin/limad-drop",
      "system_root": "/usr/share/limad-drop",
      "system_version_file": "/usr/share/limad-drop/VERSION",
      "required": [
        "limad_dropd.py",
        "shell.py",
        "VERSION"
      ],
      "restart_user_services": [
        "limad-drop.service",
        "limad-airdrop.timer"
      ]
    },
    {
      "app_id": "de.limad.Link",
      "name": "LiLink",
      "launcher": "/usr/local/bin/lilink",
      "system_root": "/usr/share/limad-link",
      "system_version_file": "/usr/share/limad-link/VERSION",
      "required": [
        "app.py",
        "daemon.py",
        "common.py",
        "VERSION"
      ],
      "restart_user_services": [
        "limad-link.service"
      ]
    },
    {
      "app_id": "de.limad.Notes",
      "name": "LiNotes",
      "launcher": "/usr/local/bin/limad-notes",
      "system_root": "/usr/share/limad-notes",
      "system_version_file": "/usr/share/limad-notes/VERSION",
      "required": [
        "app.py",
        "storage.py",
        "VERSION"
      ],
      "restart_user_services": []
    },
    {
      "app_id": "de.limad.Save",
      "name": "LiSave",
      "launcher": "/usr/local/bin/limad-save",
      "system_root": "/usr/share/limad-save",
      "system_version_file": "/usr/share/limad-save/VERSION",
      "required": [
        "app.py",
        "core.py",
        "cli.py",
        "VERSION"
      ],
      "restart_user_services": []
    },
    {
      "app_id": "de.limad.ScreenShare",
      "name": "LiMaD auf TV übertragen",
      "launcher": "/usr/local/bin/limad-screen-share",
      "system_root": "/usr/share/limad-screen-share",
      "system_version_file": "/usr/share/limad-screen-share/VERSION",
      "required": [
        "app.py",
        "VERSION"
      ],
      "restart_user_services": []
    },
    {
      "app_id": "de.limad.Mail",
      "name": "LiMaD Mail",
      "launcher": "/usr/local/bin/limad-mail",
      "system_root": "/usr/share/limad-mail",
      "system_version_file": "/usr/share/limad-mail/VERSION",
      "required": [
        "VERSION",
        "theme/limad-mail.css",
        "theme/limad-mail-content.css"
      ],
      "restart_user_services": []
    },
    {
      "app_id": "de.limad.Klang",
      "name": "LiMaD Klang",
      "launcher": "/usr/local/bin/limad-klang",
      "system_root": "/usr/share/limad-klang",
      "system_version_file": "/usr/share/limad-klang/VERSION",
      "required": [
        "VERSION",
        "limad_klang.py",
        "limad_klang_backend.py",
        "LiMaD Klang.json"
      ],
      "restart_user_services": []
    },
    {
      "app_id": "de.limad.AnycubicSlicerNext",
      "name": "Anycubic Slicer Next",
      "launcher": "/usr/bin/anycubicslicernext",
      "system_root": "/usr/lib/limad/apps/anycubic-slicer-next",
      "system_version": "1.3.96",
      "required": [
        "bin/AnycubicSlicerNext",
        "resources"
      ],
      "restart_user_services": [],
      "executables": [
        "bin/AnycubicSlicerNext"
      ]
    },
    {
      "app_id": "de.limad.WindowsApps",
      "name": "Windows-Programme",
      "launcher": "/usr/local/bin/limad-windows-setup",
      "system_root": "/usr/share/limad-windows",
      "system_version_file": "/usr/share/limad-windows/VERSION",
      "required": [
        "installer.py",
        "recipe_engine.py",
        "wine-env.sh",
        "VERSION"
      ],
      "restart_user_services": []
    }
  ]
}
