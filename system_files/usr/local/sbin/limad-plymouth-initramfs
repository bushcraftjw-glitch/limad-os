#!/usr/bin/env bash
set -Eeuo pipefail

readonly STATE_DIR=/var/lib/limad
readonly MARKER="$STATE_DIR/plymouth-initramfs-280-rc2-build1.done"
readonly LOG="$STATE_DIR/plymouth-initramfs-280-rc2-build1.log"

mkdir -p "$STATE_DIR" /etc/plymouth
exec >>"$LOG" 2>&1
printf '\n[%s] LiMaD Plymouth Build 8 deployment preparation\n' "$(date -Is 2>/dev/null || date)"

[[ -e "$MARKER" ]] && { echo 'Build 8 Plymouth deployment already completed'; exit 0; }
[[ -e /run/ostree-booted ]] || { echo 'Not an OSTree boot'; exit 0; }
[[ ! -e /run/initramfs/live ]] || { echo 'Live environment detected; skipped'; exit 0; }
command -v rpm-ostree >/dev/null 2>&1 || { echo 'rpm-ostree missing'; exit 1; }
[[ -s /usr/share/plymouth/themes/limad/limad.plymouth ]] || { echo 'LiMaD Plymouth theme missing from immutable image'; exit 1; }

cat > /etc/plymouth/plymouthd.conf <<'CONF'
[Daemon]
Theme=limad
ShowDelay=0
CONF

run_rpm_ostree() {
  local attempt
  for attempt in $(seq 1 60); do
    echo "rpm-ostree attempt ${attempt}: $*"
    if "$@"; then
      return 0
    fi
    echo 'rpm-ostree is busy or failed; waiting 10 seconds before retry'
    sleep 10
  done
  return 1
}

run_rpm_ostree rpm-ostree kargs --append-if-missing=rhgb
run_rpm_ostree rpm-ostree kargs --append-if-missing=quiet

echo 'Staging the proven LiMaD Plymouth initramfs deployment and rebooting.'
if run_rpm_ostree rpm-ostree initramfs --enable --reboot; then
  touch "$MARKER"
else
  echo 'rpm-ostree initramfs --enable --reboot failed after all retries'
  exit 1
fi
