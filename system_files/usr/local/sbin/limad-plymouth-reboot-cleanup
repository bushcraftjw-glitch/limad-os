#!/usr/bin/env bash
set -Eeuo pipefail
readonly MARKER=/var/lib/limad/plymouth-reboot-required
[[ -s "$MARKER" ]] || exit 0
previous_boot="$(cat "$MARKER" 2>/dev/null || true)"
current_boot="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
if [[ -n "$previous_boot" && -n "$current_boot" && "$previous_boot" != "$current_boot" ]]; then
  rm -f "$MARKER"
  logger -t limad-plymouth 'Restart after initramfs preparation detected; reboot reminder cleared.'
fi
