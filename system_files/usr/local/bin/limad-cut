#!/usr/bin/env bash
set -Eeuo pipefail
SYSTEM_ROOT="/usr/share/limad-cut"
USER_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/limad-updater/apps/de.limad.Cut/current/payload"
APP_ROOT="$(/usr/local/libexec/limad-select-app-root "$SYSTEM_ROOT" "$USER_ROOT" "native_shell.py")"
export LIMAD_CUT_RESOURCE_ROOT="$APP_ROOT"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/limad-cut"
mkdir -p "$STATE_DIR"
printf 'LiMaDCut native launch %s session=%s root=%s\n' "$(date --iso-8601=seconds)" "${XDG_SESSION_TYPE:-unknown}" "$APP_ROOT" >> "$STATE_DIR/native-launch.log"
exec /usr/bin/python3 "$APP_ROOT/native_shell.py" "$@"
