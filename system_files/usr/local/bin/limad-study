#!/usr/bin/env bash
set -Eeuo pipefail
SYSTEM_ROOT="/usr/share/limad-study"
USER_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/limad-updater/apps/de.limad.Study/current/payload"
APP_ROOT="$(/usr/local/libexec/limad-select-app-root "$SYSTEM_ROOT" "$USER_ROOT" "src/limad_study/__main__.py")"
export LIMAD_STUDY_RESOURCE_ROOT="$APP_ROOT"
export PYTHONPATH="$APP_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec /usr/bin/python3 -m limad_study "$@"
