#!/usr/bin/env bash
set -u
DATA="$HOME/.local/share/limad-mail"
SYSTEM_THEME="/usr/share/limad-mail/theme/limad-mail.css"
STATE="$DATA/state"
LOG="$HOME/.local/state/limad-mail/launcher.log"
mkdir -p "$(dirname "$LOG")" "$STATE"
find_flatpak_id() {
  local id
  for id in org.mozilla.thunderbird_esr org.mozilla.thunderbird org.mozilla.Thunderbird; do
    if command -v flatpak >/dev/null 2>&1 && flatpak info "$id" >/dev/null 2>&1; then
      printf '%s\n' "$id"
      return 0
    fi
  done
  return 1
}
read_gtk_theme() {
  local theme
  theme="$(cat "$STATE/gtk-theme" 2>/dev/null || true)"
  if [[ -z "$theme" ]] && command -v gsettings >/dev/null 2>&1; then
    theme="$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | sed "s/^'//;s/'$//" || true)"
  fi
  printf '%s\n' "${theme:-Adwaita-dark}"
}
{
  printf '\n[%s] LiMaD Mail Start\n' "$(date --iso-8601=seconds)"
  /usr/local/bin/limad-mail-setup --quiet || true
  MODE="$(cat "$STATE/launcher-mode" 2>/dev/null || true)"
  APP_ID="$(cat "$STATE/flatpak-id" 2>/dev/null || true)"
  GTK_THEME_NAME="$(read_gtk_theme)"
  echo "GTK-Systemtheme (nur Referenz): $GTK_THEME_NAME"
  if [[ "$MODE" == "flatpak" ]]; then
    if [[ -z "$APP_ID" ]] || ! flatpak info "$APP_ID" >/dev/null 2>&1; then
      APP_ID="$(find_flatpak_id || true)"
      [[ -n "$APP_ID" ]] && printf '%s\n' "$APP_ID" > "$STATE/flatpak-id"
    fi
    if [[ -n "$APP_ID" ]]; then
      echo "Startmodus: Flatpak $APP_ID"
      flatpak run \
        --env=GTK_APPLICATION_PREFER_DARK_THEME=1 \
        "$APP_ID" "$@"
      RC=$?
      echo "Flatpak beendet mit Code $RC"
      exit "$RC"
    fi
  fi
  if [[ "$MODE" == "native" ]] && command -v thunderbird >/dev/null 2>&1; then
    echo "Startmodus: native ($(command -v thunderbird))"
    env GTK_APPLICATION_PREFER_DARK_THEME=1 thunderbird "$@"
    exit $?
  fi
  APP_ID="$(find_flatpak_id || true)"
  if [[ -n "$APP_ID" ]]; then
    echo "Fallback: Flatpak $APP_ID"
    printf 'flatpak\n' > "$STATE/launcher-mode"
    printf '%s\n' "$APP_ID" > "$STATE/flatpak-id"
    flatpak run \
      --env=GTK_APPLICATION_PREFER_DARK_THEME=1 \
      "$APP_ID" "$@"
    exit $?
  fi
  if command -v thunderbird >/dev/null 2>&1; then
    echo "Fallback: native ($(command -v thunderbird))"
    printf 'native\n' > "$STATE/launcher-mode"
    env GTK_APPLICATION_PREFER_DARK_THEME=1 thunderbird "$@"
    exit $?
  fi
  echo "Fehler: Keine Thunderbird-Installation gefunden."
  command -v notify-send >/dev/null 2>&1 && notify-send "LiMaD Mail" "Thunderbird konnte nicht gestartet werden. Siehe $LOG"
  exit 1
} >>"$LOG" 2>&1
