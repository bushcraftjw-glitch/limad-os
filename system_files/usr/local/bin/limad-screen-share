#!/usr/bin/env bash
set -Eeuo pipefail
SYSTEM_ROOT="/usr/share/limad-screen-share"
USER_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/limad-updater/apps/de.limad.ScreenShare/current/payload"
APP_ROOT="$(/usr/local/libexec/limad-select-app-root "$SYSTEM_ROOT" "$USER_ROOT" "app.py")"
export LIMAD_SCREEN_SHARE_ROOT="$APP_ROOT"
exec /usr/bin/python3 "$APP_ROOT/app.py" "$@"
