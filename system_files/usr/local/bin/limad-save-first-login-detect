#!/usr/bin/env python3
from __future__ import annotations
import os
import subprocess
import time
from pathlib import Path

home = Path.home()
config = Path(os.environ.get("XDG_CONFIG_HOME", home / ".config")) / "limad"
marker = config / "lisave-clean-restore-offered-build5.done"
if marker.exists():
    raise SystemExit(0)
time.sleep(8)
roots = [Path("/run/media") / os.environ.get("USER", home.name), Path("/media") / os.environ.get("USER", home.name), Path("/mnt")]
found = []
for root in roots:
    if not root.is_dir():
        continue
    try:
        for candidate in root.glob("**/*.lisavebackup"):
            if (candidate / "repository/config").is_file() and (candidate / "lisave.json").is_file():
                found.append(candidate)
    except OSError:
        pass
if not found:
    raise SystemExit(0)
config.mkdir(parents=True, exist_ok=True)
marker.touch()
env = os.environ.copy()
env["LISAVE_INITIAL_TARGET"] = str(sorted(found, key=lambda p: p.stat().st_mtime, reverse=True)[0])
subprocess.Popen(["/usr/local/bin/limad-save"], env=env, start_new_session=True)
