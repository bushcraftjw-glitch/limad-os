#!/usr/bin/env bash
set -Eeuo pipefail
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/limad"
LOG_FILE="$LOG_DIR/system-update.log"
mkdir -p "$LOG_DIR"
exec > >(tee -a "$LOG_FILE") 2>&1
printf '\n[%s] LiMaD OS 3.0 system update started\n' "$(date -Is)"
if command -v limad-save-cli >/dev/null 2>&1; then
  echo 'LiSave prüft die konfigurierte Sicherung vor dem Systemupdate …'
  limad-save-cli pre-update || { echo 'LiSave-Sicherung fehlgeschlagen; Update abgebrochen.'; exit 1; }
fi
CMD='apt-get update && DEBIAN_FRONTEND=noninteractive apt-get -y full-upgrade && apt-get -y autoremove'
if command -v pkexec >/dev/null 2>&1; then exec pkexec sh -c "$CMD"; fi
exec sudo sh -c "$CMD"
