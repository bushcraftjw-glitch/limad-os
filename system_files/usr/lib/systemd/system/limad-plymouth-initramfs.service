[Unit]
Description=Prepare LiMaD Plymouth with the proven rpm-ostree path
ConditionPathExists=/run/ostree-booted
ConditionKernelCommandLine=!rd.live.image
ConditionPathExists=!/run/initramfs/live
ConditionPathExists=!/var/lib/limad/plymouth-initramfs-280-rc2-build1.done
After=rpm-ostreed.service network.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/limad-plymouth-initramfs
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
