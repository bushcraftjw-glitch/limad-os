# Central, single source of truth for the LiMaD OS GNOME image.
# Every value here is pinned. Floating branches are forbidden.

LIMAD_OS_VERSION="2.8.0-rc2"
LIMAD_BUILD_REVISION="gnome-rc2-build5"

# Logo Menu is installed from a pinned upstream tag instead of a floating
# distribution package. v24.8 declares GNOME Shell 49/50 support, which is
# required by the Fedora 44 / GNOME 50 Bazzite GNOME base. The build verifies
# the downloaded metadata against the installed GNOME Shell major version.
LIMAD_LOGOMENU_VERSION="v24.8_270626"
# Name des Container-Pakets in der Registry.
#
# Ein GHCR-Paket gehoert dem Repository, das es erstmals veroeffentlicht hat.
# Das urspruengliche Paket "limad-os" wurde vom alten Repository "imad-os"
# angelegt; ein Push aus einem anderen Repository wird mit HTTP 403 abgelehnt.
# Unter neuem Namen entsteht ein frisches Paket, das automatisch zum laufenden
# Repository gehoert.
LIMAD_IMAGE_NAME="limad-os-gnome-280"

# Upstream base image (Bazzite GNOME, Fedora Silverblue lineage).
# BASE_IMAGE_REF is the single reference the Containerfile and the workflow use.
# To freeze a known-good build, replace the tag by a digest:
#   BASE_IMAGE_REF="ghcr.io/ublue-os/bazzite-gnome@sha256:<digest>"
BASE_IMAGE="ghcr.io/ublue-os/bazzite-gnome"
BASE_IMAGE_TAG="stable"
BASE_IMAGE_REF="ghcr.io/ublue-os/bazzite-gnome:stable"

# Upstream design sources (pinned to published release tags)
MACTAHOE_REPO="https://github.com/vinceliuice/MacTahoe-gtk-theme"
MACTAHOE_TAG="2026-05-24"
MACTAHOE_LICENSE="MIT"

WHITESUR_ICONS_REPO="https://github.com/vinceliuice/WhiteSur-icon-theme"
WHITESUR_ICONS_TAG="2025-12-27"
WHITESUR_ICONS_LICENSE="GPL-3.0-only"

# Names of the artefacts produced inside the image
LIMAD_GTK_THEME_NAME="LiMaD"
LIMAD_GTK_THEME_VARIANT="LiMaD-Dark"
LIMAD_SHELL_THEME_VARIANT="LiMaD-Dark"
LIMAD_ICON_THEME_NAME="LiMaD"
# Accent used for both upstream projects. WhiteSur turns this into directory
# names such as "WhiteSur-purple-dark"; the exact name is detected during the
# build and recorded in /usr/share/limad/theme-names.env.
WHITESUR_ACCENT="purple"
LIMAD_WHITESUR_ICON_NAME="WhiteSur-dark"

# LiMaD applications shipped natively in the image
LIMAD_CUT_VERSION="1.1.4"
LIMAD_STUDY_VERSION="6.6.3"
LIDROP_VERSION=0.12.0-preview5
LIMAD_SCREEN_SHARE_VERSION="1.0.1"
LILINK_VERSION="1.0.0-preview3"
LISAVE_VERSION="1.0.0-preview2"
LINOTES_VERSION="1.0.0-preview2"
LIMAD_WINDOWS_VERSION="2.2.6"
LIMAD_CI_RUNC_VERSION="1.4.2"
LIMAD_CI_RUNC_AMD64_SHA256="ac8a90f9e225bb9322189937b230cdc5478d5753f0e31e1bda98a5cf06bd9539"

# Screen sharing: native GNOME sender for Google Cast/Miracast and an explicitly
# experimental, pinned AirPlay sender. The tag is verified against the immutable
# commit during the image build.
DOUBLETAKE_REPO="https://github.com/omarroth/doubletake.git"
DOUBLETAKE_TAG="v0.4.0"
DOUBLETAKE_COMMIT="364ea84247ce17a084ae15b9011409910e823e34"

# Optional AirDrop compatibility stack. Both projects are pinned to immutable
# commits; no floating branch is used during the image build.
OWL_REPO="https://github.com/seemoo-lab/owl.git"
OWL_COMMIT="8e4e840b212ae5a09a8a99484be3ab18bad22fa7"
OPENDROP_REPO="https://github.com/seemoo-lab/opendrop.git"
OPENDROP_COMMIT="ae5ac821fb3b233df3ac800e4eb47f287f4422cf"
OPENDROP_VERSION="0.13.0"

# Anycubic Slicer Next: reconstructed from two losslessly split DEB parts
ANYCUBIC_DEB_VERSION="1.3.96"
ANYCUBIC_BUILD_VERSION="1.3.9.4"
ANYCUBIC_SOURCE_SHA256="2c2883a9c624ab64e721a0211667852e0083d8794f7839c1d7932c9f712ed076"

# Wine based Windows installer
LIMAD_WINE_PREFIX_NAME="limad-windows"

# Feature switches evaluated by build_files/build.sh
# The login screen is theming-sensitive and irrelevant for testing the desktop.
# Switch it on again once desktop, applications and Wine are confirmed working.
LIMAD_INSTALL_GDM_THEME="1"

# A missing gnome-shell stylesheet means the top bar stays plain GNOME. That is
# not an acceptable release, so the build fails on it by default.
LIMAD_REQUIRE_SHELL_THEME="1"
# The LiMaD wallpapers ship with the repository. MacTahoe's own wallpapers are
# installed alongside them into a subfolder when this is switched on.
LIMAD_INSTALL_WALLPAPER="1"
LIMAD_DEFAULT_WALLPAPER="LiMaD-Wallpaper-02-Logo-Zentriert-4K.png"
LIMAD_INSTALL_WINE="1"

# Dateisystem, das der Installer anlegt. Bazzite verwendet btrfs; das Abbild
# selbst legt keinen Vorgabewert fest, deshalb muss der ISO-Bau ihn mitgeben.
# Möglich sind btrfs, xfs und ext4.
LIMAD_ROOTFS="btrfs"
